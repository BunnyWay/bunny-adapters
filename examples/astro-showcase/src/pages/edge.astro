---
import Layout from "../layouts/Layout.astro";

// The adapter puts the edge context on Astro.locals.runtime. Add the types to
// your project with the block in src/env.d.ts.
const runtime = Astro.locals.runtime;

const rows: [string, string][] = [
  ["Astro.clientAddress", Astro.clientAddress || "unknown"],
  ["runtime.country", runtime?.country ?? "unknown"],
  ["runtime.requestId", runtime?.requestId ?? "none"],
  ["runtime.server", runtime?.server ?? "none"],
  ["Astro.url", Astro.url.toString()],
  ["User agent", Astro.request.headers.get("user-agent") ?? "none"],
];
---

<Layout
  title="Edge context"
  lede="What the bunny.net network tells the script about a request."
  badge="Astro.locals.runtime"
>
  <div class="card">
    <table>
      <tbody>
        {
          rows.map(([label, value]) => (
            <tr>
              <th>{label}</th>
              <td class="value" id={label.toLowerCase().replace(/[^a-z]+/g, "-")}>
                {value}
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <p class="lede" style="margin-top:1.5rem">
    The country and the request id come from headers that only exist on the bunny.net network, so
    they read <code>unknown</code> when you run the site on your own machine.
  </p>

  <pre><code>{`const { country, requestId, clientAddress } = Astro.locals.runtime;

// Keep working after the response goes out.
Astro.locals.runtime.waitUntil(recordVisit(country));`}</code></pre>
</Layout>
