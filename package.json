{
  "name": "@bunny.net/astro-adapter",
  "version": "0.1.0",
  "description": "Astro adapter for bunny.net Edge Scripting. Renders Astro on the edge and serves the build assets from Bunny Storage.",
  "type": "module",
  "license": "MIT",
  "author": "bunny.net",
  "homepage": "https://bunny.net/docs/scripting/frameworks/astro",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BunnyWay/bunny-astro-adapter.git"
  },
  "bugs": "https://github.com/BunnyWay/bunny-astro-adapter/issues",
  "keywords": [
    "astro-adapter",
    "astro",
    "bunny",
    "bunny.net",
    "edge-scripting",
    "withastro"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "bunny-astro": "./dist/bin/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build",
    "test": "node test/smoke.mjs"
  },
  "dependencies": {
    "@bunny.net/edgescript-sdk": "^0.12.1",
    "esbuild": "^0.25.0"
  },
  "peerDependencies": {
    "astro": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "astro": "^7.2.3",
    "typescript": "^5.7.0"
  }
}
