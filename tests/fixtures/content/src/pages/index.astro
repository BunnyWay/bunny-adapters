---
// Rendered on demand, so the collection has to work inside the script too.
import { getCollection } from "astro:content";

const notes = (await getCollection("notes")).sort((a, b) => a.data.order - b.data.order);
---

<html>
  <body>
    <p id="count">{notes.length}</p>
    <ul>
      {notes.map((note) => <li><a href={`/notes/${note.id}`}>{note.data.title}</a></li>)}
    </ul>
  </body>
</html>
